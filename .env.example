# --- chap-scheduler --------------------------------------------------------
# All chap-scheduler settings are prefixed with CHAP_SCHEDULER_.

# CHAP_SCHEDULER_HOST=127.0.0.1
# CHAP_SCHEDULER_PORT=9090
# CHAP_SCHEDULER_LOG_LEVEL=info
# CHAP_SCHEDULER_RELOAD=false

# Mount the embedded Prefect server (API + UI + scheduler/triggers/...).
# CHAP_SCHEDULER_EMBED_PREFECT=true
# CHAP_SCHEDULER_PREFECT_MOUNT_PATH=/prefect

# How long the dhis2-chap-prediction flow waits while polling a chap job.
# Wait-time only -- chap is async and keeps running regardless. Default: 1h.
# CHAP_SCHEDULER_PREDICTION_TIMEOUT_SECONDS=3600

# --- Embedded Prefect server -----------------------------------------------
# These are read directly by Prefect when the app boots.

# Database (default: SQLite under ~/.prefect). Uncomment for compose's Postgres:
# PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://prefect:prefect@postgres:5432/prefect

PREFECT_SERVER_ANALYTICS_ENABLED=false
PREFECT_SERVER_UI_SHOW_PROMOTIONAL_CONTENT=false
